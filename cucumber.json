{
  "default": {
    "failFast": false,
    "parallel": 2,
    "retry": 0,
    "formatOptions": {
      "snippetInterface": "async-await",
      "pretty": true
    },
    "tags": "not @ignore",
    "paths": [
      "src/saucedemo/test/features/*.feature"
    ],
    "dryRun": false,
    "require": [
      "src/saucedemo/test/stepDefinitions/*.ts",
      "src/saucedemo/test/utils/hooks.ts"
    ],
    "requireModule": [
      "ts-node/register"
    ],
    "format": [
      "summary",
      "progress-bar",
      "html:src/saucedemo/cucumber-report.html",
      "json:cucumber-report.json"
    ]
  }
}

